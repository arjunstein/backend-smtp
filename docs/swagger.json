                    "type": "string",
                    "example": "no-reply@example.com"
                },
                "from_name": {
                    "type": "string",
                    "example": "Notification Agent"
                },
                "host": {
                    "type": "string",
                    "example": "smtp.gmail.com"
                },
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "is_default": {
                    "type": "boolean",
                    "example": false
                },
                "name": {
                    "type": "string",
                    "example": "Gmail Service"
                },
                "password": {
                    "type": "string",
                    "example": "secret123"
                },
                "port": {
                    "type": "integer",
                    "example": 587
                },
                "username": {
                    "type": "string",
                    "example": "no-reply@example.com"
                }
            }
        },
        "model.LoginRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "secret123"
                },
                "username_or_email": {
                    "type": "string",
                    "example": "arjun"
                }
            }
        },
        "model.RefreshTokenRequest": {
            "type": "object",
            "properties": {
                "refresh_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
            }
        },
        "model.RefreshTokenResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "expires_in": {
                    "type": "integer",
                    "example": 3600
                },
                "refresh_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                }
            }
        },
        "model.SMTPConfigResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string",
                    "example": "2026-10-20T10:00:00Z"
                },
                "encryption": {
                    "type": "string",
                    "example": "STARTTLS"
                },
                "from_email": {
                    "type": "string",
                    "example": "no-reply@example.com"
                },
                "from_name": {
                    "type": "string",
                    "example": "Notification Agent"
                },
                "host": {
                    "type": "string",
                    "example": "smtp.gmail.com"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "is_active": {
                    "type": "boolean",
                    "example": true
                },
                "is_default": {
                    "type": "boolean",
                    "example": false
                },
                "name": {
                    "type": "string",
                    "example": "Gmail Service"
                },
                "port": {
                    "type": "integer",
                    "example": 587
                },
                "updated_at": {
                    "type": "string",
                    "example": "2026-10-20T10:00:00Z"
                },
                "username": {
                    "type": "string",
                    "example": "no-reply@example.com"
                }
            }
        },
