    "definitions": {
        "model.AttachmentDTO": {
            "type": "object",
            "properties": {
                "content_base64": {
                    "type": "string",
                    "example": "JVBERi0xLjQK..."
                },
                "content_type": {
                    "type": "string",
                    "example": "application/pdf"
                },
                "filename": {
                    "type": "string",
                    "example": "invoice.pdf"
                }
            }
        },
        "model.AuthResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "expires_in": {
                    "type": "integer",
                    "example": 3600
                },
                "refresh_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "token_type": {
                    "type": "string",
